{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "matchPackageNames": ["@loglens/shared"],
      "enabled": false
    }
  ],
  "labels": ["dependencies"],
  "commitMessagePrefix": "chore(deps):"
}
