{
  "name": "loglens",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:api",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "build": "npm run build:packages && npm run build:web && npm run build:api",
    "build:packages": "npm run build --workspace @loglens/shared --workspace @loglens/validation --workspace @loglens/config --workspace @loglens/api-client",
    "build:web": "npm --workspace apps/web run build",
    "build:api": "npm --workspace apps/api run build",
    "start": "node apps/api/dist/index.js",
    "typecheck": "npm --workspace @loglens/shared run typecheck && npm --workspace @loglens/validation run typecheck && npm --workspace @loglens/config run typecheck && npm --workspace @loglens/api-client run typecheck && npm --workspace apps/api run typecheck && npm --workspace apps/web run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "validate": "npm run typecheck && npm run lint && npm run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,js,json,css,md}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.35.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^5.0.0"
  }
}
